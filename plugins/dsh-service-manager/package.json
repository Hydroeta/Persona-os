{
  "name": "dsh-service-manager",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 插件：启动时拉起 IndexTTS2 等本地微服务，dispose 时清理子进程，防止僵尸进程占满 4GB 显存。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0"
  }
}
