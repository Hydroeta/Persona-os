{
  "name": "dsh-game-agent",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 插件：通用游戏代理大脑。截屏 → VLM 决策宏观动作 → HTTP 转发给 game-bot 微服务（:8003）执行虚拟手柄信号。默认 dry_run 安全预览，单步执行不自动循环。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "test": "node test-mock.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "dependencies": {
    "node-screenshots": "^0.2.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0"
  }
}
