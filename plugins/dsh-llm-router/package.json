{
  "name": "dsh-llm-router",
  "version": "0.1.0",
  "private": true,
  "description": "DSH 插件：LLM 提供商路由（DeepSeek / Ollama / Gemini 预留）。长上下文或后台静默任务路由到本地 Ollama，主对话走 DeepSeek；暴露统一 chat() 并可拦截 agent/request。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0"
  }
}
